{
    "name": "@saoutax/dsh-full-access",
    "version": "0.1.0",
    "description": "Default every new session to Full access and drop the risk confirmation from the composer permission chip.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Saoutax/dsh-full-access"
    },
    "files": [
        "lib/index.js",
        "lib/client.js",
        "cordis.patch.yml",
        "locale/*.json",
        "icon.svg"
    ],
    "type": "module",
    "main": "lib/index.js",
    "exports": {
        ".": "./lib/index.js",
        "./client": "./lib/client.js",
        "./package.json": "./package.json",
        "./locale/*.json": "./locale/*.json",
        "./icon": "./icon.svg"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "node scripts/build.mjs",
        "check": "pnpm run fmt:check && pnpm run lint:ci && pnpm run typecheck && pnpm run test && pnpm run build",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "lint": "oxlint",
        "lint:ci": "oxlint --type-aware --type-check",
        "test": "vitest run",
        "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.test.json"
    },
    "devDependencies": {
        "@deepseek-ai/cordis": "4.1.0",
        "@deepseek-ai/schemastery": "3.19.0",
        "@types/node": "^22.10.2",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.7",
        "esbuild": "0.28.2",
        "lucide": "1.66.0",
        "oxfmt": "0.75.0",
        "oxlint": "1.90.0",
        "oxlint-tsgolint": "7.0.2005",
        "typescript": "5.7.2",
        "vitest": "^4.1.11"
    },
    "peerDependencies": {
        "@deepseek-ai/cordis": "^4.1.0",
        "@deepseek-ai/schemastery": "^3.19.0"
    },
    "peerDependenciesMeta": {
        "@deepseek-ai/cordis": {
            "optional": true
        },
        "@deepseek-ai/schemastery": {
            "optional": true
        }
    },
    "engines": {
        "dsh": ">=0.2.2-rc.1",
        "node": ">=22.19.0"
    },
    "packageManager": "pnpm@12.6.0",
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        },
        "client": {
            "platform": "web",
            "immediately": true,
            "inject": [
                "@deepseek-ai/dsh-api-remotes",
                "@deepseek-ai/dsh-api-session-controller",
                "@deepseek-ai/dsh-client-connection",
                "@deepseek-ai/dsh-client-locale",
                "@deepseek-ai/dsh-client-ui-conversation"
            ]
        }
    }
}
